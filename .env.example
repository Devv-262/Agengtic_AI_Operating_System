# --- NVIDIA NIM (primary provider) ---------------------------------------
# Get a free key at https://build.nvidia.com
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- OpenRouter (fallback provider, free-tier models) ----------------------
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Model overrides (optional) --------------------------------------------
# NIM model catalogs change over time (models get retired). If you hit a 410
# or "model not found" error, check docs.api.nvidia.com/nim/reference/llm-apis
# for the current list and update the relevant *_NIM var below — see plan.md's
# "Operational note" section for the full recovery steps.
#
# Agent loop / tool-calling model
# MODEL_AGENT_NIM=nvidia/nemotron-3-super-120b-a12b
# MODEL_AGENT_OPENROUTER=openrouter/free

# Deep reasoning / summarization / semantic ranking model
# MODEL_REASONING_NIM=nvidia/nemotron-3-ultra-550b-a55b
# MODEL_REASONING_OPENROUTER=openrouter/free

# Shell/code generation model
# MODEL_CODER_NIM=qwen/qwen2.5-coder-32b-instruct
# MODEL_CODER_OPENROUTER=openrouter/free

# --- Safety ------------------------------------------------------------
# Ask for confirmation before destructive actions (delete/move/shell exec).
# Set to "false" only for non-interactive/automated use.
REQUIRE_CONFIRMATION=true

# File tools (read/move/delete/organize) refuse to touch paths outside these
# roots. Defaults to your whole user profile (home, Desktop, Downloads,
# Documents) if unset. Comma-separated absolute paths to override.
ENABLE_PATH_SANDBOX=true
# ALLOWED_ROOTS=C:\Users\you,C:\Users\you\Desktop

# --- Semantic search ---------------------------------------------------
# Where the local vector index is persisted. Defaults to memory/vector_store
# inside the project. Embeddings are computed on-device (no API key needed).
# VECTOR_STORE_DIR=memory/vector_store
# SEMANTIC_INDEX_MAX_CHARS=8000
